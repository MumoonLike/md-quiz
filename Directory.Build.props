<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0</Version>
    <Company>明点智慧考评系统</Company>
    <Product>明点智慧考评系统</Product>
    <Copyright>明点智慧考评系统</Copyright>
    <!-- 允许在非 Windows 机器上编译 WPF 项目（只编译，不能运行） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <!-- 安装程序按 SetupProduct（Teacher / Student）分别编译，中间文件和输出分开存放，互不覆盖 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MdQuiz.Setup'">
    <SetupProduct Condition="'$(SetupProduct)' == ''">Teacher</SetupProduct>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(SetupProduct)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\$(SetupProduct)\</BaseOutputPath>
  </PropertyGroup>
</Project>
