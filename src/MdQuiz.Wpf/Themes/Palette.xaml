<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 覆盖 HandyControl 默认配色。合并在 HandyControl 皮肤之后，DynamicResource 查找时优先生效。 -->
    <Color x:Key="PrimaryColor">#4F6BED</Color>
    <Color x:Key="DarkPrimaryColor">#3F59D6</Color>
    <Color x:Key="DangerColor">#E5484D</Color>
    <Color x:Key="DarkDangerColor">#CC3D42</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DarkWarningColor">#D98B06</Color>
    <Color x:Key="InfoColor">#0EA5E9</Color>
    <Color x:Key="DarkInfoColor">#0B8BC4</Color>
    <Color x:Key="SuccessColor">#22A06B</Color>
    <Color x:Key="DarkSuccessColor">#1B8A5A</Color>
    <Color x:Key="AccentColor">#F97316</Color>
    <Color x:Key="DarkAccentColor">#EA6A0C</Color>
    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>
    <Color x:Key="ThirdlyTextColor">#9CA3AF</Color>
    <Color x:Key="ReverseTextColor">#FFFFFF</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E3E7EF</Color>
    <Color x:Key="SecondaryBorderColor">#CDD3DE</Color>
    <Color x:Key="BackgroundColor">#F4F6FB</Color>
    <Color x:Key="RegionColor">#FFFFFF</Color>
    <Color x:Key="SecondaryRegionColor">#F1F3F9</Color>
    <Color x:Key="ThirdlyRegionColor">#FFFFFF</Color>
    <Color x:Key="TitleColor">#4F6BED</Color>
    <Color x:Key="SecondaryTitleColor">#3F59D6</Color>
    <Color x:Key="DefaultColor">#FFFFFF</Color>
    <Color x:Key="DarkDefaultColor">#F1F3F9</Color>
    <Color x:Key="LightPrimaryColor">#EEF1FE</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F6BED" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#3F59D6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="DarkDangerBrush" Color="#CC3D42" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DarkWarningBrush" Color="#D98B06" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="DarkInfoBrush" Color="#0B8BC4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22A06B" />
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="#1B8A5A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F97316" />
    <SolidColorBrush x:Key="DarkAccentBrush" Color="#EA6A0C" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E7EF" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#CDD3DE" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="RegionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#F1F3F9" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBrush" Color="#4F6BED" />
    <SolidColorBrush x:Key="DefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="#F1F3F9" />

    <!-- 自定义 -->
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#EEF1FE" />
    <SolidColorBrush x:Key="LightSuccessBrush" Color="#E7F6EF" />
    <SolidColorBrush x:Key="LightDangerBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="LightWarningBrush" Color="#FEF5E6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6E9F0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F6F7FB" />
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26367A" />
        <GradientStop Offset="1" Color="#1A2556" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B76F2" />
        <GradientStop Offset="1" Color="#3E54C9" />
    </LinearGradientBrush>
    <FontFamily x:Key="MonoFont">Consolas, Courier New, Microsoft YaHei</FontFamily>
</ResourceDictionary>
