<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 明点知识考核系统标志（矢量，320×320）：蓝色 D 环 + 蓝色 M + 橙色 1 -->
    <SolidColorBrush x:Key="BrandBlueBrush" Color="#1E4FA8" />
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="#E4581C" />

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1E4FA8"
                                 Geometry="M8,0 L196,0 A122,159.5 0 0 1 318,159.5 A122,159.5 0 0 1 196,319 L0,319 L0,277 L196,277 A80,117.5 0 0 0 276,159.5 A80,117.5 0 0 0 196,42 L50,42 Z" />
                <GeometryDrawing Brush="#1E4FA8" Geometry="M0,64 L48,64 L136,184 L76,184 L48,146 L48,246 L0,246 Z" />
                <GeometryDrawing Brush="#E4581C" Geometry="M186,64 L206,64 L206,246 L152,246 L152,130 L108,130 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 深色背景上使用的标志：白色圆角底 + 彩色标志 -->
    <Style x:Key="LogoTile" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
