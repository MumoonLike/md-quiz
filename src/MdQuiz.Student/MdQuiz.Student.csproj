<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MdQuiz.Student</RootNamespace>
    <AssemblyName>MdQuiz.Student</AssemblyName>
    <AssemblyTitle>明点智慧考评系统 学生端</AssemblyTitle>
    <ApplicationIcon>..\MdQuiz.Wpf\Assets\logo.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MoveLibsOnPublish>true</MoveLibsOnPublish>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MdQuiz.Core\MdQuiz.Core.csproj" />
    <ProjectReference Include="..\MdQuiz.Wpf\MdQuiz.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
