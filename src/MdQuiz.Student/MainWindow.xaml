<Window x:Class="MdQuiz.Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="MdQuiz 学生端" Width="1200" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <ContentControl Content="{Binding Current}" Focusable="False" />

        <!-- 断线提示 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,76,0,0" Padding="20,10" CornerRadius="20"
                Background="#FFF7E6" BorderBrush="#F5C26B" BorderThickness="1"
                Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <hc:LoadingCircle Width="18" Height="18" DotDiameter="3" Foreground="#D98B06" Margin="0,0,10,0" />
                <TextBlock Foreground="#9A6200" VerticalAlignment="Center"
                           Text="与教师机的连接已断开，正在自动重连… 答案已保存在本机，可以继续作答" />
            </StackPanel>
        </Border>

        <!-- 切屏警告 -->
        <Border x:Name="FocusWarning" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,76,0,0" Padding="22,12" CornerRadius="10"
                Background="{DynamicResource DangerBrush}" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.AlertCircleOutline}" Fill="White" Width="20" Height="20" Stretch="Uniform" />
                <TextBlock x:Name="FocusWarningText" Foreground="White" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,8,0" Focusable="False">
            <StackPanel hc:Growl.GrowlParent="True" VerticalAlignment="Top" Margin="0,0,10,10" />
        </ScrollViewer>
    </Grid>
</Window>
