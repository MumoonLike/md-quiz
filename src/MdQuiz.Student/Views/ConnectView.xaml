<UserControl x:Class="MdQuiz.Student.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf">
    <Grid Background="{DynamicResource HeroBrush}">
        <!-- 装饰圆 -->
        <Ellipse Width="520" Height="520" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0" />
        <Ellipse Width="380" Height="380" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Border Style="{StaticResource LogoTile}" Width="56" Height="56" CornerRadius="14" Padding="9">
                        <Image Source="{StaticResource LogoImage}" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="明点知识考核系统" Foreground="White" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="局域网考试 · 学生端" Foreground="#DCE3FF" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource CardElevated}" Width="560" Padding="32,28">
                    <StackPanel>
                        <DockPanel>
                            <hc:LoadingCircle DockPanel.Dock="Right" Width="26" Height="26" Foreground="{DynamicResource PrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="连接教师机" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{x:Null}" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Cursor="Hand" Margin="0,0,0,10" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="10" Padding="18,14"
                                                        BorderThickness="1.5" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource LightPrimaryBrush}" Margin="0,0,14,0">
                                                <Path Data="{StaticResource Icon.LanConnect}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ExamTitle}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExamTitle}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="暂未开放考试" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <hc:Divider Content="或手动输入教师机地址" Margin="0,10,0,14" Foreground="{DynamicResource ThirdlyTextBrush}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="连接" Style="{StaticResource ButtonPrimary}" Height="40" Width="90" Margin="10,0,0,0"
                                    Command="{Binding ConnectManualCommand}" IsDefault="True" />
                            <hc:TextBox Height="40" FontSize="15" hc:InfoElement.Placeholder="例如 192.168.1.10（老师的监考页面上有显示）"
                                        Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <hc:LoadingLine Width="120" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="正在连接…" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
