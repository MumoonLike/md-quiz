<UserControl x:Class="MdQuiz.Student.Views.WaitingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Background="{DynamicResource HeroBrush}">
        <Ellipse Width="520" Height="520" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0" />
        <Ellipse Width="380" Height="380" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" />

        <Border Style="{StaticResource CardElevated}" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,32">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource HeroBrush}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="，你好" /></TextBlock>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,24" />

                <TextBlock Text="{Binding ExamTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="{Binding Duration, Mode=OneWay}" /><Run Text=" 分钟" FontSize="13" /></TextBlock>
                            <TextBlock Text="考试时长" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="10" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="{Binding QuestionCount, Mode=OneWay}" /><Run Text=" 题" FontSize="13" /></TextBlock>
                            <TextBlock Text="题目数量" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="10" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="{Binding TotalScore, Mode=OneWay}" /><Run Text=" 分" FontSize="13" /></TextBlock>
                            <TextBlock Text="满分" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="考试须知" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,4" Text="· 老师开始考试后会自动进入答题界面，并开始倒计时" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,4" Text="· 每道题的答案都会自动保存，断网也不会丢失" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,4" Text="· 考试时间到会自动交卷" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="{Binding AntiCheat, Converter={StaticResource BoolToVis}}"
                               Text="· 本场考试开启了防作弊：答题时窗口全屏，离开答题窗口会被记录并上报老师" />
                </StackPanel>

                <Border Background="{DynamicResource LightPrimaryBrush}" CornerRadius="10" Padding="18,14" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <hc:LoadingCircle Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource DarkPrimaryBrush}" FontSize="15" FontWeight="SemiBold"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
