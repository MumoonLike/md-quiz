<UserControl x:Class="MdQuiz.Student.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource HeroBrush}">
        <Ellipse Width="520" Height="520" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0" />
        <Ellipse Width="380" Height="380" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" />

        <Border Style="{StaticResource CardElevated}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,36">
            <StackPanel>
                <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource LightSuccessBrush}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.CheckCircle}" Fill="{DynamicResource SuccessBrush}" Width="48" Height="48" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="12" Padding="20,18" Margin="0,24,0,0"
                        Visibility="{Binding ShowScore, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ScoreLabel}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Run Text="{Binding Score, Mode=OneWay}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            <Run Text="{Binding ScoreTotal, Mode=OneWay}" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"
                           Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}" />

                <Button Content="退出程序" Style="{StaticResource BigDefaultButton}" HorizontalAlignment="Center" Margin="0,26,0,0" Width="160"
                        Command="{Binding ExitCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
