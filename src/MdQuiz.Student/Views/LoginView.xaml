<UserControl x:Class="MdQuiz.Student.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Background="{DynamicResource HeroBrush}">
        <Ellipse Width="520" Height="520" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0" />
        <Ellipse Width="380" Height="380" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" />

        <Border Style="{StaticResource CardElevated}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
            <StackPanel>
                <!-- 教师机与考试信息 -->
                <Border Background="{DynamicResource LightPrimaryBrush}" CornerRadius="10,10,0,0" Padding="28,18">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="切换教师机" Style="{StaticResource LinkButton}" Command="{Binding SwitchServerCommand}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <Run Text="已连接 " /><Run Text="{Binding ServerName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExam, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ExamTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ExamMeta}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasExam, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <hc:LoadingCircle Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="老师还没有开放考试，开放后即可登录" Margin="10,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="28,24,28,28">
                    <!-- 第一步：输入学号 -->
                    <StackPanel Visibility="{Binding Confirming, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="请输入学号" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="输入后会显示你的姓名，请核对无误后再登录。" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,18" />
                        <hc:TextBox x:Name="NoBox" Height="48" FontSize="20" hc:InfoElement.Placeholder="学号" InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding StudentNo, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNoKeyDown" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
                        <Button Content="下一步" Style="{StaticResource BigPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                                Command="{Binding NextCommand}" IsEnabled="{Binding HasExam}" />
                    </StackPanel>

                    <!-- 第二步：确认身份 -->
                    <StackPanel Visibility="{Binding Confirming, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="请确认你的身份" Style="{StaticResource PageTitle}" />
                        <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="12" Padding="20,18" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource HeroBrush}">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="28" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0">
                                        <Run Text="学号 " /><Run Text="{Binding StudentNo, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ClassName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
                        <UniformGrid Columns="2" Margin="0,22,0,0">
                            <Button Content="不是我，重新输入" Style="{StaticResource BigDefaultButton}" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                    Command="{Binding BackCommand}" />
                            <Button Content="确认登录" Style="{StaticResource BigPrimaryButton}" HorizontalAlignment="Stretch" Margin="6,0,0,0"
                                    Command="{Binding LoginCommand}" IsDefault="True" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
