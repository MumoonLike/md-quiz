<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MdQuiz.Student.ViewModels"
                    xmlns:views="clr-namespace:MdQuiz.Student.Views">
    <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
        <views:ConnectView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WaitingViewModel}">
        <views:WaitingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExamViewModel}">
        <views:ExamView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultViewModel}">
        <views:ResultView />
    </DataTemplate>
</ResourceDictionary>
