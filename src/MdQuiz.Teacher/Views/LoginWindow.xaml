<hc:Window x:Class="MdQuiz.Teacher.Views.LoginWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="MdQuiz 教师端" Width="780" Height="470" ResizeMode="NoResize"
           WindowStartupLocation="CenterScreen" ShowTitle="False"
           NonClientAreaBackground="#5B76F2" NonClientAreaForeground="White"
           OtherButtonForeground="White" OtherButtonHoverBackground="#22FFFFFF"
           CloseButtonForeground="White" Background="{DynamicResource RegionBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧品牌区 -->
        <Border Background="{DynamicResource HeroBrush}">
            <Grid Margin="36,32,36,36">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="14" Background="#33FFFFFF" HorizontalAlignment="Left">
                        <Path Data="{StaticResource Icon.SchoolOutline}" Fill="White" Width="30" Height="30" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="MdQuiz" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,24,0,0" />
                    <TextBlock Text="局域网答题系统 · 教师端" FontSize="16" Foreground="#E0E6FF" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="题库管理 · 随机组卷 · 实时监考 · 自动判分" Foreground="#C9D3FA" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Foreground="#A9B6F2" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧表单 -->
        <Grid Grid.Column="1" Margin="48,16,48,32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="欢迎回来" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock x:Name="SubText" Text="请输入管理密码进入教师端" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,24" />

                <TextBlock Text="管理密码" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Height="38" hc:InfoElement.Placeholder="请输入密码" KeyDown="OnPasswordKeyDown" />
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="确认密码" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ConfirmInput" Height="38" hc:InfoElement.Placeholder="再次输入密码" KeyDown="OnPasswordKeyDown" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <Button x:Name="SubmitButton" Content="进入" Style="{StaticResource BigPrimaryButton}" HorizontalAlignment="Stretch"
                        Margin="0,24,0,0" Click="OnSubmit" IsDefault="True" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" TextAlignment="Center"
                           Text="忘记密码？用命令行运行 MdQuiz.Teacher.exe --reset-password" />
            </StackPanel>
        </Grid>
    </Grid>
</hc:Window>
