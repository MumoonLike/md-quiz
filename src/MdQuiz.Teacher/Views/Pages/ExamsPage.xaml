<UserControl x:Class="MdQuiz.Teacher.Views.Pages.ExamsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="新建考试" Style="{StaticResource BigPrimaryButton}"
                    hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding CreateCommand}" />
            <StackPanel>
                <TextBlock Text="考试管理" Style="{StaticResource PageTitle}" />
                <TextBlock Text="用试卷创建考试，选择参加的班级和考试规则。开放登录后到“监考”页面开始考试。" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Exams}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                        <Setter Property="Padding" Value="20,16" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                    <ctl:Chip Margin="10,0,0,0" Text="{Binding Status, Converter={StaticResource ExamStatusText}}"
                                              Color="{Binding Status, Converter={StaticResource ExamStatusColor}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0">
                                    <Run Text="试卷：" /><Run Text="{Binding PaperName, Mode=OneWay}" />
                                    <Run Text="  ·  " /><Run Text="{Binding QuestionCount, Mode=OneWay}" /><Run Text=" 题" />
                                    <Run Text="  ·  满分 " /><Run Text="{Binding TotalScore, Mode=OneWay, Converter={StaticResource Score}}" />
                                    <Run Text="  ·  创建于 " /><Run Text="{Binding CreatedAt, Mode=OneWay, Converter={StaticResource LocalTime}, ConverterParameter='yyyy-MM-dd HH:mm'}" />
                                </TextBlock>
                            </StackPanel>
                            <!-- 考试时间 -->
                            <Border Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Width="196" Padding="12,7" CornerRadius="8"
                                    Background="{DynamicResource SecondaryRegionBrush}">
                                <Grid>
                                    <StackPanel Visibility="{Binding StartedAt, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                                        <TextBlock FontSize="13">
                                            <Run Text="时长 " Foreground="{DynamicResource SecondaryTextBrush}" /><Run Text="{Binding TotalMinutes, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 分钟" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="尚未开考" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Grid Visibility="{Binding StartedAt, Converter={StaticResource HasValueToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="开始" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" FontSize="13" FontFamily="{StaticResource MonoFont}"
                                                   Text="{Binding StartedAt, Converter={StaticResource LocalTime}, ConverterParameter='yyyy-MM-dd HH:mm'}" />
                                        <TextBlock Grid.Row="1" Text="{Binding EndLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,3,10,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,3,0,0"
                                                   Text="{Binding EndAt, Converter={StaticResource LocalTime}, ConverterParameter='yyyy-MM-dd HH:mm'}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Margin="24,0" VerticalAlignment="Center" MinWidth="110" TextAlignment="Right"
                                       Text="尚未开放登录" Style="{StaticResource Muted}"
                                       Visibility="{Binding ParticipantCount, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                            <StackPanel Grid.Column="2" Margin="24,0" VerticalAlignment="Center" MinWidth="110"
                                        Visibility="{Binding ParticipantCount, Converter={StaticResource HasValueToVis}}">
                                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold">
                                    <Run Text="{Binding SubmittedCount, Mode=OneWay}" /><Run Text=" / " Foreground="{DynamicResource ThirdlyTextBrush}" /><Run Text="{Binding ParticipantCount, Mode=OneWay}" Foreground="{DynamicResource ThirdlyTextBrush}" />
                                </TextBlock>
                                <TextBlock Text="已交卷 / 应考" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="开放 / 监考" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.MonitorEye}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ended">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="成绩" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.ChartBoxOutline}"
                                        Command="{Binding DataContext.ResultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource ButtonIcon}" Foreground="{DynamicResource DangerBrush}" ToolTip="删除考试"
                                        hc:IconElement.Geometry="{StaticResource Icon.DeleteOutline}" Width="36" Height="32"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.ClipboardTextOutline}" Fill="{DynamicResource ThirdlyTextBrush}" Width="56" Height="56" Stretch="Uniform" />
                    <TextBlock Text="还没有考试" Style="{StaticResource EmptyHint}" FontSize="16" Margin="0,16,0,6" />
                    <TextBlock Text="准备好题库、试卷和学生名单后，点击右上角“新建考试”。" Style="{StaticResource EmptyHint}" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
