<UserControl x:Class="MdQuiz.Teacher.Views.Pages.QuestionBankPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf"
             xmlns:views="clr-namespace:MdQuiz.Teacher.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="导入 Markdown" Style="{StaticResource ButtonDefault}" Height="36" Margin="0,0,8,0"
                        hc:IconElement.Geometry="{StaticResource Icon.LanguageMarkdownOutline}" Command="{Binding ImportMarkdownCommand}" />
                <Button Content="导入 Excel" Style="{StaticResource ButtonDefault}" Height="36" Margin="0,0,8,0"
                        hc:IconElement.Geometry="{StaticResource Icon.FileExcelOutline}" Command="{Binding ImportExcelCommand}" />
                <Button Content="新建题目" Style="{StaticResource ButtonPrimary}" Height="36"
                        hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding NewCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="题库" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 筛选 -->
        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,18,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="导出 Markdown" Style="{StaticResource LinkButton}" Margin="0,0,6,0" Command="{Binding ExportMarkdownCommand}" />
                    <Button Content="下载 Excel 模板" Style="{StaticResource LinkButton}" Command="{Binding DownloadTemplateCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hc:TextBox Width="260" Height="34" hc:InfoElement.Placeholder="搜索题干、选项、标签…" hc:InfoElement.ShowClearButton="True"
                                Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <ComboBox Width="130" Height="34" Margin="10,0,0,0" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedType}" />
                    <ComboBox Width="150" Height="34" Margin="10,0,0,0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
                    <Button Content="清除筛选" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- 题目列表 -->
            <Grid>
                <ListBox x:Name="QuestionList" Style="{StaticResource CardList}" ItemsSource="{Binding Questions}" SelectedItem="{Binding Selected}"
                         SelectionMode="Extended" MouseDoubleClick="OnListDoubleClick" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ctl:Chip Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}"
                                          Color="{Binding Type, Converter={StaticResource TypeColor}}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TagsText}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Visibility="{Binding TagsText, Converter={StaticResource HasValueToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditCommand}" />
                            <MenuItem Header="复制一份" Command="{Binding DuplicateCommand}" />
                            <Separator />
                            <MenuItem Header="删除选中" Command="{Binding DeleteCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- 空题库引导 -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Path Data="{StaticResource Icon.BookOpenVariant}" Fill="{DynamicResource ThirdlyTextBrush}" Width="56" Height="56" Stretch="Uniform" />
                        <TextBlock Text="题库还是空的" Style="{StaticResource EmptyHint}" FontSize="16" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource EmptyHint}" FontSize="13"
                                   Text="可以逐题新建，也可以用 Markdown 或 Excel 批量导入。程序目录下的 samples 文件夹里有示例题库。" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 预览 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="0"
                    Visibility="{Binding Selected, Converter={StaticResource HasValueToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="复制一份" hc:IconElement.Geometry="{StaticResource Icon.ContentCopy}"
                                        Foreground="{DynamicResource SecondaryTextBrush}" Width="34" Height="32" Command="{Binding DuplicateCommand}" />
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="删除" hc:IconElement.Geometry="{StaticResource Icon.DeleteOutline}"
                                        Foreground="{DynamicResource DangerBrush}" Width="34" Height="32" Margin="0,0,8,0"
                                        Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItems, ElementName=QuestionList}" />
                                <Button Content="编辑" Style="{StaticResource ButtonPrimary}" hc:IconElement.Geometry="{StaticResource Icon.PencilOutline}"
                                        Command="{Binding EditCommand}" />
                            </StackPanel>
                            <TextBlock Text="题目预览" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <views:QuestionPreview Question="{Binding Selected.Question}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
