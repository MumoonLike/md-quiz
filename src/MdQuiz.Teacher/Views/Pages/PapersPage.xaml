<UserControl x:Class="MdQuiz.Teacher.Views.Pages.PapersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf"
             xmlns:vm="clr-namespace:MdQuiz.Teacher.ViewModels">
    <UserControl.Resources>
        <!-- 树节点容器：去掉默认缩进和选中底色，外观由数据模板决定 -->
        <Style x:Key="PaperTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
                            <ItemsPresenter x:Name="ItemsHost" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 试卷列表（按分组折叠） -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonIcon}" ToolTip="新建分组" hc:IconElement.Geometry="{StaticResource Icon.FolderPlusOutline}"
                            Foreground="{DynamicResource PrimaryBrush}" Width="36" Height="36" Margin="0,0,6,0" Command="{Binding NewGroupCommand}" />
                    <Button Content="新建" Style="{StaticResource ButtonPrimary}" Height="36" ToolTip="新建试卷（放在当前试卷所在的分组）"
                            hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding NewCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="试卷" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid>
                <TreeView x:Name="PaperTree" ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0" Padding="0"
                          ItemContainerStyle="{StaticResource PaperTreeItem}" SelectedItemChanged="OnTreeSelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                    <TreeView.Template>
                        <ControlTemplate TargetType="TreeView">
                            <ScrollViewer Focusable="False" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="0,0,6,0" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </TreeView.Template>
                    <TreeView.Resources>
                        <!-- 分组标题：点击展开 / 折叠 -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:PaperGroupNode}" ItemsSource="{Binding Papers}"
                                                  ItemContainerStyle="{StaticResource PaperTreeItem}">
                            <ToggleButton Style="{x:Null}" IsChecked="{Binding IsExpanded}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,4,0,6"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ToggleButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="在此分组新建试卷" Command="{Binding PlacementTarget.Tag.NewInGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="重命名分组" Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsUngrouped, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <MenuItem Header="删除分组" Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsUngrouped, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron" Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" Stretch="Uniform"
                                                      Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                                <Path x:Name="Folder" Grid.Column="1" Data="{StaticResource Icon.FolderOutline}" Width="17" Height="17" Stretch="Uniform"
                                                      Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="6,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <Border Grid.Column="3" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Papers.Count}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Border>
                                                <Button x:Name="MoreButton" Grid.Column="4" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.DotsHorizontal}"
                                                        Foreground="{DynamicResource SecondaryTextBrush}" Width="26" Height="22" Padding="5" Margin="4,0,0,0" ToolTip="分组操作"
                                                        Click="OnGroupMenu" Visibility="Hidden" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter TargetName="MoreButton" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="Folder" Property="Data" Value="{StaticResource Icon.FolderOpenOutline}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                                <Setter TargetName="Folder" Property="Fill" Value="{DynamicResource ThirdlyTextBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </HierarchicalDataTemplate>

                        <!-- 试卷 -->
                        <DataTemplate DataType="{x:Type vm:PaperNode}">
                            <Border x:Name="Card" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="18,0,0,8" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="{Binding Paper.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                        <Run Text="{Binding Paper.Items.Count, Mode=OneWay}" /><Run Text=" 题 · 满分 " /><Run Text="{Binding Paper.TotalScore, Mode=OneWay, Converter={StaticResource Score}}" />
                                        <Run Text=" · " /><Run Text="{Binding Paper.UpdatedAt, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <TextBlock Text="还没有试卷&#x0a;点击“新建”开始组卷，&#x0a;或点击左上角的文件夹按钮新建分组" Style="{StaticResource EmptyHint}"
                           Visibility="{Binding Groups.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
            </Grid>
        </DockPanel>

        <!-- 编辑区 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- 基本信息 -->
                <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <ctl:Chip Text="未保存" Color="#F59E0B" Margin="0,0,10,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="复制试卷" hc:IconElement.Geometry="{StaticResource Icon.ContentCopy}"
                                        Foreground="{DynamicResource SecondaryTextBrush}" Width="34" Height="32" Command="{Binding DuplicateCommand}" />
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="删除试卷" hc:IconElement.Geometry="{StaticResource Icon.DeleteOutline}"
                                        Foreground="{DynamicResource DangerBrush}" Width="34" Height="32" Margin="0,0,8,0" Command="{Binding DeleteCommand}" />
                                <Button Content="预览" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.EyeOutline}" Command="{Binding PreviewCommand}" />
                                <Button Content="保存" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.ContentSaveOutline}" Command="{Binding SaveCommand}" />
                                <Button Content="创建考试" Style="{StaticResource ButtonSuccess}"
                                        hc:IconElement.Geometry="{StaticResource Icon.SendCheckOutline}" Command="{Binding CreateExamCommand}" />
                            </StackPanel>
                            <hc:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold"
                                     BorderThickness="0" Background="Transparent" Padding="0" hc:InfoElement.Placeholder="试卷名称" Margin="0,0,16,0" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                                <Path Data="{StaticResource Icon.FolderOutline}" Style="{StaticResource Icon}" Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox Width="170" Height="32" Margin="6,0,0,0" ItemsSource="{Binding GroupOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedGroupOption}" ToolTip="所属分组（修改后立即生效）" />
                            </StackPanel>
                            <hc:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="32"
                                        hc:InfoElement.Placeholder="说明（可选，仅教师可见）" />
                        </DockPanel>

                        <!-- 统计 -->
                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6" />
                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" ToolTip="点击统一设置该题型每题分值"
                                                Command="{Binding DataContext.SetScoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Chip Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}" Color="{Binding Type, Converter={StaticResource TypeColor}}" />
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 题目操作 -->
                <Border DockPanel.Dock="Top" Padding="24,12" Background="{DynamicResource SecondaryRegionBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="按题型排序" Style="{StaticResource LinkButton}" Command="{Binding SortByTypeCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="从题库选题" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"
                                    hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding AddManualCommand}" />
                            <Button Content="随机抽题" Style="{StaticResource ButtonDefault}"
                                    hc:IconElement.Geometry="{StaticResource Icon.DiceMultipleOutline}" Command="{Binding AddRandomCommand}" />
                            <TextBlock Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding MissingCount, Converter={StaticResource HasValueToVis}}">
                                <Run Text="有" /><Run Text="{Binding MissingCount, Mode=OneWay}" /><Run Text="道题已从题库删除，保存后将从试卷移除" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 题目列表 -->
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12,8" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ctl:Chip Grid.Column="1" Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}"
                                              Color="{Binding Type, Converter={StaticResource TypeColor}}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0">
                                        <hc:NumericUpDown Width="96" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1"
                                                          Value="{Binding Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="分" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.ArrowUp}" ToolTip="上移"
                                                Foreground="{DynamicResource SecondaryTextBrush}" Width="30" Height="30" Padding="7"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.ArrowDown}" ToolTip="下移"
                                                Foreground="{DynamicResource SecondaryTextBrush}" Width="30" Height="30" Padding="7"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.Close}" ToolTip="移出试卷"
                                                Foreground="{DynamicResource DangerBrush}" Width="30" Height="30" Padding="8"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Items.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                        <Path Data="{StaticResource Icon.FileDocumentEditOutline}" Fill="{DynamicResource ThirdlyTextBrush}" Width="48" Height="48" Stretch="Uniform" />
                        <TextBlock Text="试卷里还没有题目" Style="{StaticResource EmptyHint}" Margin="0,12,0,4" />
                        <TextBlock Text="点击上方“从题库选题”或“随机抽题”" Style="{StaticResource EmptyHint}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.FileDocumentEditOutline}" Fill="{DynamicResource ThirdlyTextBrush}" Width="56" Height="56" Stretch="Uniform" />
                <TextBlock Text="选择左侧的试卷进行编辑，或新建一份试卷" Style="{StaticResource EmptyHint}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
