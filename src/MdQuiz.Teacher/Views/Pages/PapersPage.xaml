<UserControl x:Class="MdQuiz.Teacher.Views.Pages.PapersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 试卷列表 -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="新建" Style="{StaticResource ButtonPrimary}" Height="36"
                        hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding NewCommand}" VerticalAlignment="Center" />
                <TextBlock Text="试卷" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                    <Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=" 题 · 满分 " /><Run Text="{Binding TotalScore, Mode=OneWay, Converter={StaticResource Score}}" />
                                    <Run Text=" · " /><Run Text="{Binding UpdatedAt, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="还没有试卷&#x0a;点击“新建”开始组卷" Style="{StaticResource EmptyHint}"
                           Visibility="{Binding Papers.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
            </Grid>
        </DockPanel>

        <!-- 编辑区 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- 基本信息 -->
                <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <ctl:Chip Text="未保存" Color="#F59E0B" Margin="0,0,10,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="复制试卷" hc:IconElement.Geometry="{StaticResource Icon.ContentCopy}"
                                        Foreground="{DynamicResource SecondaryTextBrush}" Width="34" Height="32" Command="{Binding DuplicateCommand}" />
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="删除试卷" hc:IconElement.Geometry="{StaticResource Icon.DeleteOutline}"
                                        Foreground="{DynamicResource DangerBrush}" Width="34" Height="32" Margin="0,0,8,0" Command="{Binding DeleteCommand}" />
                                <Button Content="预览" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.EyeOutline}" Command="{Binding PreviewCommand}" />
                                <Button Content="保存" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"
                                        hc:IconElement.Geometry="{StaticResource Icon.ContentSaveOutline}" Command="{Binding SaveCommand}" />
                                <Button Content="创建考试" Style="{StaticResource ButtonSuccess}"
                                        hc:IconElement.Geometry="{StaticResource Icon.SendCheckOutline}" Command="{Binding CreateExamCommand}" />
                            </StackPanel>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold"
                                     BorderThickness="0" Background="Transparent" Padding="0" hc:InfoElement.Placeholder="试卷名称" Margin="0,0,16,0" />
                        </DockPanel>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                                 hc:InfoElement.Placeholder="说明（可选，仅教师可见）" />

                        <!-- 统计 -->
                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6" />
                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Margin="0,0,8,6" ToolTip="点击统一设置该题型每题分值"
                                                Command="{Binding DataContext.SetScoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Chip Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}" Color="{Binding Type, Converter={StaticResource TypeColor}}" />
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 题目操作 -->
                <Border DockPanel.Dock="Top" Padding="24,12" Background="{DynamicResource SecondaryRegionBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="按题型排序" Style="{StaticResource LinkButton}" Command="{Binding SortByTypeCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="从题库选题" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"
                                    hc:IconElement.Geometry="{StaticResource Icon.Plus}" Command="{Binding AddManualCommand}" />
                            <Button Content="随机抽题" Style="{StaticResource ButtonDefault}"
                                    hc:IconElement.Geometry="{StaticResource Icon.DiceMultipleOutline}" Command="{Binding AddRandomCommand}" />
                            <TextBlock Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding MissingCount, Converter={StaticResource HasValueToVis}}">
                                <Run Text="有" /><Run Text="{Binding MissingCount, Mode=OneWay}" /><Run Text="道题已从题库删除，保存后将从试卷移除" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 题目列表 -->
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12,8" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ctl:Chip Grid.Column="1" Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}"
                                              Color="{Binding Type, Converter={StaticResource TypeColor}}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0">
                                        <hc:NumericUpDown Width="96" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1"
                                                          Value="{Binding Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="分" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.ArrowUp}" ToolTip="上移"
                                                Foreground="{DynamicResource SecondaryTextBrush}" Width="30" Height="30" Padding="7"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.ArrowDown}" ToolTip="下移"
                                                Foreground="{DynamicResource SecondaryTextBrush}" Width="30" Height="30" Padding="7"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.Close}" ToolTip="移出试卷"
                                                Foreground="{DynamicResource DangerBrush}" Width="30" Height="30" Padding="8"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Items.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                        <Path Data="{StaticResource Icon.FileDocumentEditOutline}" Fill="{DynamicResource ThirdlyTextBrush}" Width="48" Height="48" Stretch="Uniform" />
                        <TextBlock Text="试卷里还没有题目" Style="{StaticResource EmptyHint}" Margin="0,12,0,4" />
                        <TextBlock Text="点击上方“从题库选题”或“随机抽题”" Style="{StaticResource EmptyHint}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.FileDocumentEditOutline}" Fill="{DynamicResource ThirdlyTextBrush}" Width="56" Height="56" Stretch="Uniform" />
                <TextBlock Text="选择左侧的试卷进行编辑，或新建一份试卷" Style="{StaticResource EmptyHint}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
