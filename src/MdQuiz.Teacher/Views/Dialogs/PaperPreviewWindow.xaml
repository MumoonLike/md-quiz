<hc:Window x:Class="MdQuiz.Teacher.Views.Dialogs.PaperPreviewWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:MdQuiz.Teacher.Views"
           Title="试卷预览" Width="900" Height="800" ShowInTaskbar="False"
           Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
            <DockPanel>
                <CheckBox x:Name="ShowAnswerBox" DockPanel.Dock="Right" Content="显示答案与解析" IsChecked="True" VerticalAlignment="Center"
                          Checked="OnShowAnswerChanged" Unchecked="OnShowAnswerChanged" />
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SubText" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QuestionList" Margin="28,18" MaxWidth="820">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="22,18">
                            <views:QuestionPreview Question="{Binding Question}" Score="{Binding Score}" Number="{Binding Number}"
                                                   ShowAnswer="{Binding ShowAnswer}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</hc:Window>
