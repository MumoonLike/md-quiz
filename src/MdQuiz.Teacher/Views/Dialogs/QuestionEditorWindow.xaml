<hc:Window x:Class="MdQuiz.Teacher.Views.Dialogs.QuestionEditorWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:MdQuiz.Teacher.Views"
           Title="编辑题目" Width="1120" Height="780" MinWidth="900" MinHeight="600" ShowInTaskbar="False"
           Background="{DynamicResource BackgroundBrush}">
    <hc:Window.Resources>
        <Style x:Key="MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="Auto" />
        </Style>
    </hc:Window.Resources>
    <DockPanel>
        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource ButtonDefault}" Width="88" Height="36" Margin="0,0,10,0" IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource ButtonPrimary}" Width="110" Height="36"
                            hc:IconElement.Geometry="{StaticResource Icon.ContentSaveOutline}" Click="OnSave" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}">
                    <Path Data="{StaticResource Icon.AlertCircleOutline}" Style="{StaticResource Icon}" Fill="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 题型 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="题型" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <RadioButton Style="{StaticResource Segment}" Content="单选题" IsChecked="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Single}" />
                <RadioButton Style="{StaticResource Segment}" Content="多选题" IsChecked="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Multiple}" />
                <RadioButton Style="{StaticResource Segment}" Content="判断题" IsChecked="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=TrueFalse}" />
                <RadioButton Style="{StaticResource Segment}" Content="填空题" IsChecked="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=FillBlank}" />
                <RadioButton Style="{StaticResource Segment}" Content="简答题" IsChecked="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=ShortAnswer}" />
            </StackPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- 编辑 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="插入空位 ___" Style="{StaticResource LinkButton}" Click="OnInsertBlank"
                                            Visibility="{Binding IsFill, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="插入公式" Style="{StaticResource LinkButton}" Click="OnInsertFormula" />
                                    <Button Content="插入图片" Style="{StaticResource LinkButton}" Click="OnInsertImage" />
                                    <Button Content="加粗" Style="{StaticResource LinkButton}" Click="OnInsertBold" />
                                    <Button Content="代码" Style="{StaticResource LinkButton}" Click="OnInsertCode" />
                                </StackPanel>
                                <TextBlock Text="题干" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="StemBox" Style="{StaticResource MultiLine}" MinHeight="130" MaxHeight="320"
                                     Text="{Binding Stem, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="支持 Markdown：**加粗**、`代码`、```代码块```、表格、$公式$。填空题用 ___（三个及以上下划线）表示空位。" />
                        </StackPanel>
                    </Border>

                    <!-- 选择题选项 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="添加选项" Style="{StaticResource LinkButton}" Command="{Binding AddOptionCommand}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="选项" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    <TextBlock Text="（勾选正确答案）" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsCorrect}" VerticalAlignment="Top" Margin="0,9,8,0" ToolTip="正确答案" />
                                            <TextBlock Grid.Column="1" Text="{Binding Letter}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Top" Margin="0,7,0,0" />
                                            <TextBox Grid.Column="2" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="34" VerticalContentAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.Close}"
                                                    Foreground="{DynamicResource ThirdlyTextBrush}" Width="32" Height="32" Padding="9" VerticalAlignment="Top" Margin="4,1,0,0"
                                                    ToolTip="删除选项"
                                                    Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 判断题 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsTrueFalse, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="正确答案" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="  对  " GroupName="tf" IsChecked="{Binding TfTrue}" />
                                <RadioButton Style="{StaticResource Segment}" Content="  错  " GroupName="tf" IsChecked="{Binding TfFalse}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 填空题 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsFill, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="每个空的答案" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="同一个空有多个可接受的答案时，用 | 分隔，例如：北京 | 北京市。判分时忽略首尾空格、全半角和大小写。"
                                       Style="{StaticResource Muted}" Margin="0,4,0,12" />
                            <TextBlock Text="题干中还没有空位，请用 ___（三个下划线）标出需要填写的位置。" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding Blanks.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Blanks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" Width="64" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 简答题 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsShort, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="参考答案" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="简答题由老师人工批改，参考答案会显示在批改界面中。" Style="{StaticResource Muted}" Margin="0,4,0,10" />
                            <TextBox Style="{StaticResource MultiLine}" MinHeight="100" Text="{Binding ShortAnswer, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- 解析与标签 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="解析（可选）" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource MultiLine}" MinHeight="70" Text="{Binding Analysis, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="标签（可选，用逗号分隔，用于筛选和随机抽题）" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                            <hc:TextBox Height="36" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="例如：数学, 第一章" />
                            <ItemsControl ItemsSource="{Binding KnownTags}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" ContentStringFormat="+ {0}" Style="{StaticResource LinkButton}" Margin="0,0,4,2" FontSize="12"
                                                Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 预览 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="20,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.EyeOutline}" Style="{StaticResource Icon}" Fill="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <views:QuestionPreview Question="{Binding Preview}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</hc:Window>
