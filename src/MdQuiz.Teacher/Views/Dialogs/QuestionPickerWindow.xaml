<hc:Window x:Class="MdQuiz.Teacher.Views.Dialogs.QuestionPickerWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf"
           Title="从题库选题" Width="980" Height="740" MinHeight="520" ShowInTaskbar="False"
           Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource ButtonDefault}" Width="88" Height="36" Margin="0,0,10,0" IsCancel="True" />
                    <Button x:Name="AddButton" Content="添加所选" Style="{StaticResource ButtonPrimary}" Height="36" Click="OnAdd"
                            hc:IconElement.Geometry="{StaticResource Icon.Plus}" />
                </StackPanel>
                <!-- 每种题型的默认分值 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每题分值：" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="单选" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <hc:NumericUpDown x:Name="ScoreSingle" Width="72" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1" Value="2" Margin="0,0,10,0" />
                    <TextBlock Text="多选" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <hc:NumericUpDown x:Name="ScoreMultiple" Width="72" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1" Value="4" Margin="0,0,10,0" />
                    <TextBlock Text="判断" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <hc:NumericUpDown x:Name="ScoreTf" Width="72" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1" Value="1" Margin="0,0,10,0" />
                    <TextBlock Text="填空" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <hc:NumericUpDown x:Name="ScoreFill" Width="72" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1" Value="2" Margin="0,0,10,0" />
                    <TextBlock Text="简答" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <hc:NumericUpDown x:Name="ScoreShort" Width="72" Height="30" Minimum="0" Maximum="1000" Increment="0.5" DecimalPlaces="1" Value="10" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="全选当前列表" Style="{StaticResource LinkButton}" Click="OnSelectAll" />
                    <Button Content="清空选择" Style="{StaticResource LinkButton}" Click="OnClear" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hc:TextBox x:Name="KeywordBox" Width="240" Height="34" hc:InfoElement.Placeholder="搜索题目…" hc:InfoElement.ShowClearButton="True"
                                TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="TypeBox" Width="130" Height="34" Margin="10,0,0,0" DisplayMemberPath="Name" SelectionChanged="OnFilterChanged" />
                    <ComboBox x:Name="TagBox" Width="150" Height="34" Margin="10,0,0,0" SelectionChanged="OnFilterChanged" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="PickList" Style="{StaticResource CardList}" Margin="20,14">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="IsEnabled" Value="{Binding CanPick}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ctl:Chip Grid.Column="1" Text="{Binding Type, Converter={StaticResource TypeName}, ConverterParameter=short}"
                                  Color="{Binding Type, Converter={StaticResource TypeColor}}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TagsText}" Style="{StaticResource Muted}" Visibility="{Binding TagsText, Converter={StaticResource HasValueToVis}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="已在试卷中" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding CanPick, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</hc:Window>
