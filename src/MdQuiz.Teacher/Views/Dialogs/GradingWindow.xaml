<hc:Window x:Class="MdQuiz.Teacher.Views.Dialogs.GradingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf"
           xmlns:views="clr-namespace:MdQuiz.Teacher.Views"
           Title="批改 / 改分" Width="1240" Height="820" MinWidth="980" MinHeight="600" ShowInTaskbar="False"
           WindowState="Maximized" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 题目列表 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="ExamTitle" Style="{StaticResource SectionTitle}" FontSize="17" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="选择题目，逐个给学生打分。分数修改后立即保存。" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <ListBox x:Name="QuestionList" Style="{StaticResource CardList}" SelectionChanged="OnQuestionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding PendingText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPending}" Value="True">
                                                <Setter Property="Foreground" Value="#8B5CF6" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Number, StringFormat='{}{0}.'}" FontWeight="SemiBold" Width="28" VerticalAlignment="Center" />
                                <ctl:Chip Text="{Binding TypeText}" Color="{Binding TypeColor}" />
                                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 批改区 -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="300" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <views:QuestionPreview x:Name="Preview" />
                </ScrollViewer>
            </Border>
            <DockPanel Grid.Row="1" Margin="2,14,2,10">
                <CheckBox x:Name="OnlyPendingBox" DockPanel.Dock="Right" Content="只看待批改" VerticalAlignment="Center"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <TextBlock x:Name="AnswerSummary" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox Grid.Row="2" x:Name="AnswerList" Style="{StaticResource CardList}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                        <Setter Property="Padding" Value="18,14" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding StudentNo}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                <ctl:Chip Text="{Binding StatusText}" Color="{Binding StatusColor}" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AnswerText}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
                                    <TextBlock Text="{Binding CorrectText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                               Visibility="{Binding CorrectText, Converter={StaticResource HasValueToVis}}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Width="190">
                                <StackPanel Orientation="Horizontal">
                                    <hc:NumericUpDown Width="110" Height="34" Minimum="0" Maximum="{Binding MaxScore}" Increment="0.5" DecimalPlaces="2"
                                                      Value="{Binding Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="/ " /><Run Text="{Binding MaxText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="0 分" Style="{StaticResource ButtonDefault}" Height="28" Padding="10,0" Margin="0,0,6,0" Click="OnZero" />
                                    <Button Content="满分" Style="{StaticResource ButtonDefault}" Height="28" Padding="10,0" Margin="0,0,6,0" Click="OnFull" />
                                    <Button Content="恢复自动" Style="{StaticResource LinkButton}" FontSize="12" Click="OnReset" ToolTip="清除人工给分，恢复自动判分"
                                            Visibility="{Binding Manual, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" x:Name="EmptyText" Style="{StaticResource EmptyHint}" Text="没有需要显示的答卷" Visibility="Collapsed" />
        </Grid>
    </Grid>
</hc:Window>
