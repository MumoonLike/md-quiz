<hc:Window x:Class="MdQuiz.Teacher.Views.Dialogs.StudentAnswersWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:ctl="clr-namespace:MdQuiz.Wpf.Controls;assembly=MdQuiz.Wpf"
           xmlns:vm="clr-namespace:MdQuiz.Teacher.ViewModels"
           Title="考生答卷" Width="1280" Height="840" MinWidth="1000" MinHeight="620"
           Background="{DynamicResource BackgroundBrush}" PreviewKeyDown="OnPreviewKeyDown">
    <hc:Window.Resources>
        <!-- 选项：学生选择 / 正确答案 -->
        <DataTemplate x:Key="OptionRowTemplate" DataType="{x:Type vm:AnswerOptionRow}">
            <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="0,6,0,0" BorderThickness="1.5"
                    Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Badge" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource RegionBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="Letter" Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <ctl:MarkdownView Grid.Column="1" Markdown="{Binding Text}" FontSize="14" BlockSpacing="4" Margin="12,3,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ctl:Chip x:Name="ChosenChip" Text="学生选择" Color="#4F6BED" Visibility="Collapsed" Margin="0,0,6,0" />
                        <ctl:Chip x:Name="CorrectChip" Text="正确答案" Color="#22A06B" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter TargetName="ChosenChip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightDangerBrush}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="Letter" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                    <Setter TargetName="CorrectChip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChosen}" Value="True" />
                        <Condition Binding="{Binding IsCorrect}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightSuccessBrush}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessBrush}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 一道题 -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:AnswerCard}">
            <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Chip Text="{Binding VerdictText}" Color="{Binding VerdictColor}" />
                            <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center">
                                <Run Text="第" Foreground="{DynamicResource SecondaryTextBrush}" /><Run Text="{Binding Number, Mode=OneWay}" /><Run Text="题" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </TextBlock>
                            <ctl:Chip Text="{Binding TypeName}" Color="{Binding TypeColor}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding MaxText}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ctl:MarkdownView Markdown="{Binding Stem}" FontSize="15" BlockSpacing="8" />

                    <!-- 选择 / 判断 -->
                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0" ItemTemplate="{StaticResource OptionRowTemplate}"
                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />

                    <!-- 填空 -->
                    <ItemsControl ItemsSource="{Binding Blanks}" Margin="0,10,0,0" Visibility="{Binding IsFill, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AnswerBlankRow}">
                                <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource LightDangerBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Answer" Grid.Column="1" Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis">
                                            <Run Text="参考：" /><Run Text="{Binding Accepted, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                        <Setter TargetName="Answer" Property="Text" Value="（未填）" />
                                        <Setter TargetName="Answer" Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 简答 -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsShort, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <TextBox Text="{Binding ShortText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         FontSize="14" Padding="0" Visibility="{Binding Answered, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="（未作答）" Foreground="{DynamicResource ThirdlyTextBrush}"
                                           Visibility="{Binding Answered, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <Expander Header="参考答案" Margin="0,8,0,0" Visibility="{Binding Reference, Converter={StaticResource HasValueToVis}}">
                            <ctl:MarkdownView Markdown="{Binding Reference}" FontSize="13" Margin="4,6,0,0" />
                        </Expander>
                    </StackPanel>

                    <!-- 未作答（选择 / 判断题） -->
                    <TextBlock Text="学生未作答" Foreground="{DynamicResource ThirdlyTextBrush}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Answered}" Value="False" />
                                            <Condition Binding="{Binding IsChoice}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Analysis, Converter={StaticResource HasValueToVis}}">
                        <Run Text="解析：" FontWeight="SemiBold" /><Run Text="{Binding Analysis, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </hc:Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 考生列表 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="16" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10">
                    <Run Text="共 " /><Run Text="{Binding Students.Count, Mode=OneWay}" /><Run Text=" 名考生 · ↑↓ 或 PageUp / PageDown 切换" />
                </TextBlock>
                <hc:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="34" hc:InfoElement.Placeholder="搜索学号或姓名" />
            </StackPanel>
            <ListBox x:Name="StudentList" Style="{StaticResource CardList}" ItemsSource="{Binding StudentsView}" SelectedItem="{Binding Selected}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnswerStudentRow}">
                        <DockPanel>
                            <ctl:Chip DockPanel.Dock="Right" Text="{Binding StatusText}" Color="{Binding StatusColor}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding StudentNo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 答卷 -->
        <Grid Grid.Column="1" Margin="18,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardElevated}" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StudentName}" FontSize="20" FontWeight="SemiBold" />
                            <ctl:Chip Text="{Binding StatusText}" Color="{Binding StatusColor}" Margin="10,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="10,2,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding FocusLost, Converter={StaticResource HasValueToVis}}">
                                <Path Data="{StaticResource Icon.AlertCircleOutline}" Style="{StaticResource Icon}" Width="14" Height="14" Fill="{DynamicResource WarningBrush}" />
                                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <Run Text="切屏 " /><Run Text="{Binding FocusLost, Mode=OneWay}" /><Run Text=" 次" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding StudentInfo}" Style="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding AnsweredText}" Style="{StaticResource BigNumber}" FontSize="22" HorizontalAlignment="Right" />
                            <TextBlock Text="已答" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource BigNumber}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ScoreLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonDefault}" Height="36" Margin="0,0,6,0" ToolTip="上一位考生（PageUp）"
                                hc:IconElement.Geometry="{StaticResource Icon.ChevronLeft}" Content="上一位" Command="{Binding PreviousCommand}" />
                        <TextBlock Text="{Binding Position}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,10,0" MinWidth="40" TextAlignment="Center" />
                        <Button Style="{StaticResource ButtonPrimary}" Height="36" Margin="0,0,6,0" ToolTip="下一位考生（PageDown）"
                                Command="{Binding NextCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="下一位" VerticalAlignment="Center" />
                                <Path Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Stretch="Uniform" Fill="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource Icon.Refresh}" ToolTip="刷新"
                                Foreground="{DynamicResource SecondaryTextBrush}" Width="36" Height="36" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 筛选 -->
            <DockPanel Grid.Row="1" Margin="0,14,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Style="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="460" TextAlignment="Right" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="全部题目" IsChecked="True" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                    <RadioButton Style="{StaticResource Segment}" Command="{Binding SetFilterCommand}" CommandParameter="wrong">
                        <TextBlock><Run Text="答错 " /><Run Text="{Binding WrongCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" Command="{Binding SetFilterCommand}" CommandParameter="blank">
                        <TextBlock><Run Text="未作答 " /><Run Text="{Binding BlankCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" Content="待批改" Command="{Binding SetFilterCommand}" CommandParameter="pending" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CardsView}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,6,0" />
                </ScrollViewer>
                <TextBlock Text="没有符合条件的题目" Style="{StaticResource EmptyHint}"
                           Visibility="{Binding CardsView.IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>

        <TextBlock Grid.Column="1" Text="在左侧选择一名考生" Style="{StaticResource EmptyHint}"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

        <ctl:ToastHost Grid.Column="1" Margin="0,0,24,24" />
    </Grid>
</hc:Window>
